# Salin ke .env.local lalu isi sesuai kebutuhan. Semua opsional.

# Scene Spline untuk halaman /holo (URL .splinecode dari menu Export → Code di Spline).
# Kosong = scene demo resmi dari README @splinetool/react-spline.
VITE_SPLINE_SCENE=

# Project ID / embed ID Unicorn Studio untuk halaman /holo.
# Kosong = fallback shader dithering buatan sendiri (OGL).
VITE_UNICORN_PROJECT_ID=

# File .riv untuk panel Rive di /lab (+ nama state machine & input trigger-nya).
# Kosong = contoh resmi Rive "vehicles.riv" (state machine "bumpy", input "bump").
VITE_RIVE_SRC=
VITE_RIVE_STATE_MACHINE=
VITE_RIVE_INPUT=
